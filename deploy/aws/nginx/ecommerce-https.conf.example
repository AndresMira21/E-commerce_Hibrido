# NO instalar/activar antes de tener dominio, DNS y certificados validos.
# Reemplazar todos los example.invalid y rutas de certificados, comprobar nginx -t.
server {
    listen 80 default_server;
    server_name example.invalid;
    include /etc/nginx/snippets/ecommerce-access.conf;
    return 308 https://example.invalid$request_uri;
}
server {
    listen 443 ssl default_server;
    server_name example.invalid;
    ssl_certificate /etc/letsencrypt/live/example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ECOMMERCE_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    include /etc/nginx/snippets/ecommerce-access.conf;
    include /etc/nginx/snippets/ecommerce-security.conf;
    include /etc/nginx/snippets/ecommerce-routes.conf;
    access_log /var/log/nginx/ecommerce-access.log;
    error_log /var/log/nginx/ecommerce-error.log warn;
    # HSTS solo despues de validar TLS y la recuperacion; no habilitar a ciegas.
}
