# Ejemplo PUBLICO. Crear el archivo real fuera del repositorio, chmod 600.
POSTGRES_USERNAME=ecommerce
POSTGRES_PASSWORD=
POSTGRES_DB=ecommerce_inventory
RABBITMQ_USERNAME=ecommerce_app
RABBITMQ_PASSWORD=
# Informativas: Compose/Nginx NO sustituyen automaticamente estos valores.
AWS_REGION=
EC2_PUBLIC_IP=
DEMO_DOMAIN=
ADMIN_CIDR=
# Mantener el mismo project-name durante toda la vida de los volumenes EC2.
COMPOSE_PROJECT_NAME=ecommerce-aws
